#!/bin/bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd "$script_dir/../../.." && pwd)"
foundation_root="$script_dir/foundation"
workload_root="$script_dir/workload"

aws_region="${AWS_REGION:-us-east-2}"
deployment_name="${KUBERNETES_DEPLOYMENT_NAME:-cbs-kubernetes-smoke}"
dind_source_image="${DIND_SOURCE_IMAGE:-docker:28.3.3-dind}"
scale_profile="${KUBERNETES_SCALE_PROFILE:-smoke}"
destroy_retry_delay_seconds="${KUBERNETES_DESTROY_RETRY_DELAY_SECONDS:-10}"
foundation_destroy_max_attempts=3

source "$script_dir/lib/profiles.sh"
source "$script_dir/lib/runtime.sh"
source "$script_dir/lib/deploy.sh"
source "$script_dir/lib/destroy.sh"

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

require_value() {
  local name="$1"
  local value="${!name:-}"
  [[ -n "$value" ]] || fail "$name is required."
}

require_commands() {
  local command_name
  for command_name in aws curl docker git kubectl openssl terraform uv; do
    command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is required."
  done
}

validate_inputs() {
  require_value AWS_ACCOUNT_ID
  require_value AWS_OPERATOR_CIDR
  require_value AWS_PROFILE

  [[ "$AWS_PROFILE" == "vals-dev" ]] || fail "AWS_PROFILE must be vals-dev."
  [[ "$AWS_ACCOUNT_ID" =~ ^[0-9]{12}$ ]] || fail "AWS_ACCOUNT_ID must be a 12-digit account ID."
  [[ "$deployment_name" =~ ^[a-z][a-z0-9-]{2,24}$ ]] || fail \
    "KUBERNETES_DEPLOYMENT_NAME must be a 3-25 character lowercase DNS label."
  [[ "$destroy_retry_delay_seconds" =~ ^[0-9]+$ ]] || fail \
    "KUBERNETES_DESTROY_RETRY_DELAY_SECONDS must be a non-negative integer."

  uv run python - "$AWS_OPERATOR_CIDR" >/dev/null <<'PY'
import ipaddress
import sys

network = ipaddress.IPv4Network(sys.argv[1], strict=False)
if network.prefixlen < 24:
    raise ValueError("AWS_OPERATOR_CIDR must be no broader than /24")
PY
}

validate_identity() {
  local identity
  local actual_account
  local actual_arn

  identity="$(aws sts get-caller-identity --profile vals-dev --query '[Account,Arn]' --output text)"
  read -r actual_account actual_arn <<< "$identity"

  [[ "$actual_arn" == arn:aws:* ]] || fail \
    "AWS identity must use the commercial aws partition; got $actual_arn."
  [[ "$actual_account" == "$AWS_ACCOUNT_ID" ]] || fail \
    "AWS account mismatch: expected $AWS_ACCOUNT_ID, got $actual_account."
}

preflight() {
  require_commands
  validate_inputs
  configure_scale_profile
  configure_paths
  validate_identity
}

main() {
  [[ "$#" == "1" ]] || fail "Usage: $0 plan|deploy|port-forward|test|destroy"
  preflight

  case "$1" in
    plan) plan_foundation ;;
    deploy) deploy_stack ;;
    port-forward) port_forward ;;
    test) run_live_test ;;
    destroy) destroy_stack ;;
    *) fail "Unknown command: $1" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
