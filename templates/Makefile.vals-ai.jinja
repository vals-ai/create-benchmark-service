.PHONY: install snapshot dev test lint typecheck format check

install:
	uv sync --dev

snapshot:
	uv run python -c 'from pathlib import Path; from vals_datasets import LocalSnapshotStore; ref = LocalSnapshotStore(Path(".local/store")).create_snapshot("{{ benchmark_name }}", Path("dataset")); Path(".local/dataset-ref.txt").write_text(str(ref) + "\n"); print(ref)'

dev: snapshot
	AUTH_REQUIRED=false VALS_DATASET_STORE="$(CURDIR)/.local/store" VALS_DATASET_CACHE="$(CURDIR)/.local/cache" VALS_DATASET_ROUTES="$(CURDIR)/config/routes.json" uv run uvicorn main:app --host 127.0.0.1 --port 8001 --reload

test:
	uv run pytest

lint:
	uv run ruff check .

typecheck:
	uv run basedpyright .

format:
	uv run ruff check --fix .

check: lint typecheck test
